/* ===== Design Tokens ===== */
page {
  --bg-primary: #0f0f0f;
  --bg-secondary: #1a1a1a;
  --bg-tertiary: #262626;
  --bg-elevated: #2d2d2d;
  --text-primary: #f0f0f0;
  --text-secondary: #b0b0b0;
  --text-muted: #777;
  --border: #333;
  --border-light: #2a2a2a;
  --accent: #19c37d;
  --accent-light: rgba(25, 195, 125, 0.12);
  --accent-glow: rgba(25, 195, 125, 0.20);
  --accent-strong: #0ea05a;
  --danger: #ef4444;
  --danger-light: rgba(239, 68, 68, 0.12);
  --warning: #eab308;
  --warning-light: rgba(234, 179, 8, 0.12);
  --blue: #3b82f6;
  --blue-light: rgba(59, 130, 246, 0.12);
  --purple: #8b5cf6;
  --purple-light: rgba(139, 92, 246, 0.12);
  --user-bubble: #1e3a5f;
  --ai-bubble: #1e1e1e;
  --radius-sm: 8rpx;
  --radius: 14rpx;
  --radius-lg: 20rpx;
  --radius-full: 999rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.40);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.50);
  --gradient-accent: linear-gradient(135deg, #19c37d 0%, #0ea05a 100%);
  --gradient-blue: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  --gradient-purple: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  --gradient-warning: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
  --gradient-danger: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  --font-mono: "SF Mono", "Fira Code", "Consolas", monospace;

  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  height: 100%;
  overflow-y: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ===== Layout ===== */
.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg-primary);
  transition: padding-bottom 0.25s ease-out;
}

/* ===== Universal Card ===== */
.card {
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-light);
}

.card-accent {
  border-left: 4rpx solid var(--accent);
}

/* ===== Buttons ===== */
.btn-primary {
  background: var(--gradient-accent);
  color: #fff;
  border: none;
  border-radius: var(--radius);
  padding: 22rpx 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx var(--accent-glow);
  transition: all 0.15s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-primary[disabled] {
  opacity: 0.4;
  box-shadow: none;
  transform: none;
}

.btn-secondary {
  background: var(--bg-tertiary);
  color: var(--text-primary);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 22rpx 32rpx;
  font-size: 28rpx;
  transition: all 0.15s ease;
}

.btn-secondary:active {
  background: var(--bg-elevated);
  border-color: var(--accent);
}

.btn-secondary[disabled] {
  opacity: 0.4;
}

.btn-sm {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  line-height: 1.5;
}

.btn-sm:active {
  color: var(--accent);
  border-color: var(--accent);
}

.btn-ghost {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  background: transparent;
  border: none;
  color: var(--text-muted);
}

.btn-ghost:active {
  color: var(--text-primary);
}

/* ===== Shared Chat Components ===== */
.msg {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
  max-width: 88%;
  animation: msgIn 0.3s ease-out;
}

.msg.user {
  margin-left: auto;
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.msg.user .msg-avatar {
  background: var(--gradient-blue);
}

.msg.assistant .msg-avatar {
  background: var(--gradient-accent);
}

.msg-content {
  padding: 18rpx 22rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
  white-space: pre-wrap;
  box-shadow: var(--shadow-sm);
}

.msg.user .msg-content {
  background: var(--user-bubble);
  border-bottom-right-radius: 6rpx;
  color: #d6e8ff;
}

.msg.assistant .msg-content {
  background: var(--ai-bubble);
  border: 1rpx solid var(--border);
  border-bottom-left-radius: 6rpx;
}

.msg-label {
  font-size: 22rpx;
  color: var(--accent);
  display: block;
  margin-bottom: 6rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* ===== Shared Input Area ===== */
.input-area {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-secondary);
  border-top: 1rpx solid var(--border-light);
  align-items: flex-end;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.15);
}

.input-field {
  flex: 1;
  background: var(--bg-tertiary);
  color: var(--text-primary);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  max-height: 180rpx;
  transition: border-color 0.2s;
}

.input-field:focus {
  border-color: var(--accent);
}

.btn-send {
  width: 72rpx;
  height: 72rpx;
  background: var(--gradient-accent);
  color: #fff;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  padding: 0;
  line-height: 1;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx var(--accent-glow);
  transition: all 0.15s ease;
}

.btn-send:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.btn-send[disabled] {
  opacity: 0.35;
  box-shadow: none;
  transform: none;
}

/* ===== Typing indicator ===== */
.typing-dots {
  display: flex;
  gap: 8rpx;
  padding: 10rpx 0;
}

.typing-dots view {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-muted);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.typing-dots view:nth-child(2) { animation-delay: 0.18s; }
.typing-dots view:nth-child(3) { animation-delay: 0.36s; }

/* ===== Section Title ===== */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

/* ===== States ===== */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  color: var(--text-muted);
  font-size: 28rpx;
  display: block;
  margin-bottom: 8rpx;
}

.empty-hint {
  color: var(--text-muted);
  font-size: 24rpx;
  opacity: 0.6;
}

.loading-state {
  text-align: center;
  padding: 120rpx;
}

.loading-text {
  color: var(--text-muted);
  font-size: 28rpx;
}

.loading-spinner {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

.error-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--danger);
  font-size: 28rpx;
}

/* ===== Animations ===== */
@keyframes msgIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes dotPulse {
  0%, 60%, 100% { opacity: 0.25; transform: scale(0.75); }
  30% { opacity: 1; transform: scale(1); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

.slide-up {
  animation: slideUp 0.35s ease-out;
}
